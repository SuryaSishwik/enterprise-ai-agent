# Universal AI Configuration Template (.env.example)
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-pro

NVIDIA_API_KEY=your_nvidia_nim_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

GROK_API_KEY=your_xai_grok_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

CUSTOM_LLM_BASE_URL=https://api.groq.com/openai/v1
CUSTOM_LLM_API_KEY=your_custom_key_here
CUSTOM_LLM_MODEL=llama-3.3-70b-versatile

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_db
CHROMA_PERSIST_DIR=./chroma_db
JWT_SECRET_KEY=enterprise-super-secret-key-change-me
